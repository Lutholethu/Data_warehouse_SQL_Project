/*
===============================================================================
DDL Script: Create Bronze Tables
===============================================================================
Script Purpose:
    This script creates tables in the 'bronze' schema, dropping existing tables 
    if they already exist.
	  Run this script to re-define the DDL structure of 'bronze' Tables
===============================================================================
*/

--- creating table in bronnze schema
CREATE TABLE IF NOT EXISTS bronze.price_prediction 
(
	car_ID integer,
	brand character varying(50),
	year character varying(50) ,
	engine_size real,
	fuel_type VARCHAR(50),
	transmission VARCHAR(50),
	milleage integer,
	condition character varying(50),
	price real,
	model character varying(50)
	

);


-- DROP TABLE IF EXISTS bronze."bronze.bmw_sales";

CREATE TABLE IF NOT EXISTS bronze."bronze.bmw_sales"
(
    model character varying(50),
    year character varying (50),
    region character varying(50),
    color character varying(50),
    fuel_type character varying(50),
    transmission character varying(50),
    "engine_size_L" real,
    milleage_km integer,
    price_usd numeric,
    sales_volume integer,
    sales_classification character varying (50)
);

ALTER TABLE IF EXISTS bronze."bronze.bmw_sales";
    

